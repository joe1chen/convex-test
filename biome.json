{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "*.ts",
      "convex/**",
      "*.json",
      "!**/_generated",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noNonNullAssertion": "off",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "filenameCases": ["camelCase", "kebab-case", "snake_case"]
          }
        },
        "noExportedImports": "off",
        "useDestructuring": "off",
        "noParameterProperties": "off",
        "useReadonlyClassProperties": "off",
        "useConsistentTypeDefinitions": "off",
        "useConsistentMemberAccessibility": "off",
        "noIncrementDecrement": "off",
        "noInferrableTypes": "off",
        "noNegationElse": "off",
        "noNestedTernary": "off",
        "noParameterAssign": "off",
        "noUnusedTemplateLiteral": "off",
        "noUselessElse": "off",
        "useAtIndex": "off",
        "useBlockStatements": "off",
        "useCollapsedIf": "off",
        "useConsistentArrayType": "off",
        "useConsistentArrowReturn": "off",
        "useConsistentMethodSignatures": "off",
        "useDefaultParameterLast": "off",
        "useDefaultSwitchClause": "off",
        "useErrorCause": "off",
        "useForOf": "off",
        "useImportType": "off",
        "useNumberNamespace": "off",
        "useNumericSeparators": "off",
        "useShorthandAssign": "off",
        "useTemplate": "off",
        "useUnifiedTypeSignatures": "off"
      },
      "suspicious": {
        "noUnnecessaryConditions": "off",
        "noEmptyBlockStatements": "off",
        "noExplicitAny": "off",
        "useAwait": "off",
        "noBitwiseOperators": "off",
        "noConfusingVoidType": "off",
        "noDoubleEquals": "off",
        "noEvolvingTypes": "off",
        "noImplicitAnyLet": "off",
        "noPrototypeBuiltins": "off",
        "noShadow": "off",
        "useStaticResponseMethods": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noRedundantDefaultExport": "off",
        "noDivRegex": "off",
        "noForEach": "off",
        "noUselessUndefined": "off",
        "noUselessUndefinedInitialization": "off",
        "noVoid": "off",
        "useArrayFind": "off",
        "useLiteralKeys": "off",
        "noUselessStringConcat": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noDelete": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "correctness": {
        "noUnreachable": "off",
        "noUnusedFunctionParameters": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "organizeImports": "off"
      }
    }
  }
}
