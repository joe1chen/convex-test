{
  "name": "@joe1chen/convex-test",
  "version": "0.0.61",
  "private": true,
  "description": "A JS mock of the Convex backend for testing Convex functions: get-convex/convex-test with Dogomedia's patches rebased on top (FORK.md), on this workspace's toolchain.",
  "keywords": [
    "test",
    "jest",
    "vitest",
    "convex"
  ],
  "homepage": "https://github.com/joe1chen/convex-test#readme",
  "bugs": {
    "url": "https://github.com/joe1chen/convex-test/issues"
  },
  "repository": "github:joe1chen/convex-test",
  "license": "Apache-2.0",
  "author": "Sarah Shader & Michal Srb <srb@convex.dev>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.ts"
  },
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "format:layer": "cargo run --quiet --release --manifest-path /Users/josephchen/Dev/gongboo-ban/tools/check-banned-patterns/Cargo.toml -- --strip-comments $(git ls-files '*.ts' ':!:**/_generated/**') && biome check --write .",
    "prepare": "[ -d .git ] && lefthook install || true",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.16.5",
    "convex": "1.46.0",
    "jose": "^6.2.3",
    "lefthook": "^2.1.17",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.4",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "convex": "^1.46.0"
  }
}
